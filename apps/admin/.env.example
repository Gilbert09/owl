# VITE_-prefixed so Vite exposes them on import.meta.env.
#
# NOT process.env — Vite's `define` entries are "defined as globals during dev
# and statically replaced during build", so a define of process.env.TALYN_* is
# served to the dev browser unsubstituted and throws on the missing `process`
# global. The desktop's webpack EnvironmentPlugin pattern does not port.
#
# In production these live as Vercel project environment variables;
# vite.config.ts fails the build outright if any of the first three is empty.

VITE_TALYN_API_URL=http://localhost:4747
VITE_TALYN_SUPABASE_URL=http://127.0.0.1:54321
VITE_TALYN_SUPABASE_ANON_KEY=

# Optional.
# VITE_TALYN_POSTHOG_KEY=phc_xxx
# VITE_TALYN_POSTHOG_HOST=https://us.i.posthog.com
# Set from VERCEL_GIT_COMMIT_SHA in CI; becomes the X-Talyn-Client-Version
# suffix (admin/<sha>).
# VITE_TALYN_BUILD_SHA=local
